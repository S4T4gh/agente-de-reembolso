# ------------------------------------------------------------------ modelo
# As duas linhas que você recebeu por mensagem. É só isto: não há chave de
# nuvem, provedor nem região para configurar.
#
# O modelo é Gemini 2.5 Flash Lite, servido por um gateway da banca. A sua
# chave é individual e tem crédito de 1 milhão de tokens de entrada e 1 milhão
# de saída. Confira o que sobrou com:  python -m app.llm
BOOTCAMP_LLM_ENDPOINT=
BOOTCAMP_API_KEY=

# --------------------------------------------------------------------- MCP
# O servidor MCP roda na sua máquina. Suba com:
#   docker compose up mcp
# ou clone o repositório mcp-operadora e rode:
#   MCP_OPERADORA_DADOS=./casos_treino MCP_OPERADORA_TOKEN=treino \
#       python -m mcp_operadora.server
MCP_OPERADORA_URL=http://localhost:9000/mcp
MCP_OPERADORA_TOKEN=treino
